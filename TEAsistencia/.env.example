# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.
APP_NAME=Asistente TE

# Modelo de IA: anthropic | openai (compatible) | none (sin IA: solo respuestas directas, 0 tokens)
LLM_PROVIDER=anthropic
MODEL_NAME=claude-haiku-5-5
LLM_API_KEY=

# Seguridad (obligatorios en producción)
ADMIN_TOKEN=cambia-por-un-texto-largo-y-aleatorio
ID_SALT=cambia-por-otro-texto-largo-y-aleatorio

# Zona horaria de la planta (reinicio diario de cupos y fechas)
TIMEZONE=America/Hermosillo

# Publicación del catálogo desde /admin (opcional)
GITHUB_TOKEN=
GITHUB_REPO=usuario/te-asistente
GITHUB_BRANCH=main

# Avisos de preguntas sin respuesta (opcional, p. ej. webhook de Teams o Slack)
REPORT_WEBHOOK_URL=

# Muestra el enlace discreto "Administración" al pie del chat
SHOW_ADMIN_LINK=true
